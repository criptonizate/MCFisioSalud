rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Users: own user can read/write. Admin can read all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Pacientes: admin full access. Patient can read/update own.
    match /pacientes/{pacienteId} {
      allow read: if isOwner(pacienteId) || isAdmin();
      allow create: if isOwner(pacienteId) || isAdmin();
      allow update: if isOwner(pacienteId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Turnos
    match /turnos/{turnoId} {
      // Queries (list) son públicas: necesario para mostrar slots disponibles a visitantes no autenticados.
      // Lecturas individuales (get) están restringidas al dueño y admin.
      allow list: if true;
      allow get: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.estado == 'cancelado');
      allow delete: if isAdmin();
    }

    // Disponibilidad: admin write, public read.
    match /disponibilidad/{diaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bloqueos: admin write, public read.
    match /bloqueos/{bloqueoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config: admin write, public read.
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Obras Sociales: authenticated read, admin write.
    match /obrasSociales/{osId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Lista de espera: paciente crea la suya, admin gestiona.
    match /listaEspera/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
